<svg width="800" height="450" viewBox="0 0 800 450" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="g3" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#6366f1" stop-opacity="0.9"/>
      <stop offset="100%" stop-color="#090d1f" stop-opacity="1"/>
    </linearGradient>
    <pattern id="grid3" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="rgba(255,255,255,0.06)" stroke-width="1"/>
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill="url(#g3)"/>
  <rect width="100%" height="100%" fill="url(#grid3)"/>
  <circle cx="400" cy="225" r="140" fill="rgba(99,102,241,0.15)" filter="blur(40px)"/>
  <text x="400" y="195" font-family="system-ui, sans-serif" font-size="38" font-weight="900" fill="#ffffff" text-anchor="middle" letter-spacing="3">STAFFORD HOUSE</text>
  <text x="400" y="240" font-family="system-ui, sans-serif" font-size="20" font-weight="600" fill="#a5b4fc" text-anchor="middle" letter-spacing="2">INTENSIVE ENGLISH CERTIFICATE • LONDRES</text>
  <text x="400" y="285" font-family="monospace" font-size="14" fill="rgba(255,255,255,0.6)" text-anchor="middle">Sua foto do certificado pode substituir este arquivo em public/assets/project-stafford.png</text>
